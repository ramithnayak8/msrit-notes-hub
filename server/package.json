{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:courses": "tsx --env-file-if-exists=.env src/scripts/seed-courses.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/ensure-indexes.ts",
    "user:role": "tsx --env-file-if-exists=.env src/scripts/set-role.ts",
    "import:papers": "tsx --env-file-if-exists=.env src/scripts/import-papers.ts",
    "eval": "tsx --env-file-if-exists=.env src/scripts/eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@huggingface/transformers": "^4.3.1",
    "@napi-rs/canvas": "^1.0.10",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.1.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "~7.7.0",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}

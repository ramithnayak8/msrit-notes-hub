# Copy to .env and fill in. Only MONGODB_URI and the two JWT secrets are required.

PORT=4000
NODE_ENV=development
# Origin of the Next.js client, for CORS and cookies
CLIENT_ORIGIN=http://localhost:3000

# Local Atlas container (npm run db:up) or an Atlas M0 connection string
MONGODB_URI=mongodb://localhost:27017/conceptquery?directConnection=true

# Long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Only addresses on this domain can register
ALLOWED_EMAIL_DOMAIN=msrit.edu

# SMTP for verification emails (Brevo, Gmail app password, ...).
# Leave SMTP_HOST empty in development: verification links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ConceptQuery <no-reply@conceptquery.local>"

# Language model for ingestion (tagging) and the study assistant. Any one key is enough; Gemini is tried first, then Claude.
# Without any key, tagging falls back to nearest-topic matching on embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Or Claude through the Anthropic API (tried after Gemini, before Groq/Ollama). Key: console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Or a local model through Ollama (free, offline; tried after Gemini/Groq), e.g. `ollama pull qwen2.5:3b`
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Let the model re-segment papers the rule-based parser can't follow (set false for a small local model: slow)
SEGMENT_WITH_LLM=true

# Run the ingestion worker inside the API process
RUN_WORKER=true

# Proxies in front of the API that add to X-Forwarded-For, so rate limits see each student's IP:
# 1 behind one proxy (Render, a load balancer), 2 when the site is on Vercel forwarding /api to such a host.
TRUST_PROXY=1

# LOCAL DEVELOPMENT ONLY: run the model through the Claude Code CLI on your own
# logged-in Claude account instead of an API key. Needs `claude` installed and
# logged in on this machine; tried before Gemini/Groq when enabled.
USE_CLAUDE_CODE=false
CLAUDE_CODE_MODEL=sonnet

# Study assistant: with a Gemini, Anthropic or Groq key (or Ollama), signed-in students get answers written by the
# model from retrieved archive data only (Claude Code is never used for this). Without a key,
# or with ASSISTANT_LLM=false, answers are composed from retrieval alone.
ASSISTANT_LLM=true
ASSISTANT_MODEL=gemini-flash-lite-latest
ASSISTANT_TIMEOUT_MS=12000
# AI answers per signed-in student per day, and for the whole site per day (midnight IST reset).
ASSISTANT_USER_DAILY=20
ASSISTANT_GLOBAL_DAILY=500

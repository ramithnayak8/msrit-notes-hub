# Team backend (REST, see docs/BACKEND_CONTRACT.md). Include any path prefix, no trailing slash.
# Leave unset to use the bundled SQLite database (npm run seed).
# BACKEND_URL=http://localhost:5000/api

# Optional: how long to wait for the backend before showing the error page (ms).
# BACKEND_TIMEOUT_MS=8000

# Optional: Claude API key for the study assistant (falls back to an extractive answer without it).
# ANTHROPIC_API_KEY=

# Public URL of this site, for Open Graph tags.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
